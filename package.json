{
  "name": "jev-ui-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:binary": "node scripts/release/build-binary.mjs --out-dir dist/release",
    "test": "pnpm build && pnpm -r test",
    "test:release": "node --test scripts/release/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.27.7",
    "eslint": "^10.11.0",
    "jsdom": "catalog:",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.8",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
